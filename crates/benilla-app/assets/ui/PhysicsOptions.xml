<Ui>
    <!--
        Fork: the options window's Physics page, the ragdoll fork's settings. It lives in its own
        file, loaded after OptionsFrame.xml, so the fork never edits upstream's options window: at
        load it adds a Physics row under the System group's last row (Audio), a page body, a search
        head, and its rows to BENILLA_OPTIONS_CATEGORY_KEYS and BENILLA_OPTIONS_PAGE_ROWS, which
        every page loop reads.
    -->

    <Script><![CDATA[
        -- 1.12 has no setting for any of these: violenceLevel was fixed by region.
        BENILLA_TOOLTIP_BLOOD =
            "How much blood combat shows: the spurt on a hit, the spray of droplets, and the "
            .. "splats and pools left on the ground.\n\n"
            .. "Green turns red blood green, as the game did in regions that censored it. Off "
            .. "shows none."

        BENILLA_TOOLTIP_GORE_AMOUNT =
            "How much blood each hit throws: the droplets, the splats they leave, and the size "
            .. "of the pools under the dead."

        BENILLA_TOOLTIP_DISMEMBERMENT =
            "Lets heavy killing blows tear limbs off a ragdolled body: one limb when the blow "
            .. "takes a fifth of its health, two when it takes half."

        BENILLA_TOOLTIP_DISMEMBER_AMOUNT =
            "How easily limbs come off. Higher lets lighter killing blows sever limbs."

        BENILLA_TOOLTIP_DEATH_PUSH =
            "How hard a killing blow throws the body away from the killer. A heavier blow "
            .. "throws it further. High settings get silly."

        BENILLA_TOOLTIP_DEATH_LIFT =
            "How much a body pops up as it dies, before it falls. A heavier killing blow lifts "
            .. "it more. High settings launch it."

        BENILLA_TOOLTIP_SPELL_PUSH =
            "How much harder a spell's killing blow throws the body than a melee one, on top "
            .. "of Death Push."

        BENILLA_TOOLTIP_BODY_PHYSICS =
            "How much female characters' bodies sway as they move. Lowest turns it off."

        BENILLA_TOOLTIP_MELEE_DELAY =
            "How long (seconds) a body killed by a melee swing waits before it falls, so the "
            .. "swing lands first. Spells are not delayed."
        BENILLA_TOOLTIP_DEATH_EFFECTS =
            "What the killing blow leaves on the body: melee kills gush blood upward, fire kills "
            .. "burn and then smoke, frost kills burst into ice."
        BENILLA_TOOLTIP_RAGDOLL_STIFFNESS =
            "How stiffly a body's joints hold as it falls. Low lets limbs flop and swing; high keeps "
            .. "the pose it died in, short of a frozen body's."

        BENILLA_TOOLTIP_BODY_SIZE =
            "The size of the chest that Body Physics moves, on female characters."

        BENILLA_TOOLTIP_BODY_REAR_SIZE =
            "The size of the rear that Body Physics moves, on female characters. It bounces "
            .. "less than the chest."

        BENILLA_TOOLTIP_WEAPON_MOTION =
            "How much weapons and shields on the back or hip bounce and sway as their wearer "
            .. "moves. Lowest turns it off."

        BENILLA_TOOLTIP_FOOT_PLANTING =
            "How much feet follow the ground under each of them on slopes and steps, the hips "
            .. "sinking and the legs bending to reach. Lowest turns it off."

        BENILLA_TOOLTIP_OMNI_MOVEMENT =
            "S (or a gamepad stick pulled down) turns you around and runs instead of backpedalling. "
            .. "Holding the right mouse button backpedals as usual."

        BENILLA_TOOLTIP_BLOOD_STAINS =
            "How big the blood stains bleeding hits leave on the body are. Lowest turns them off. "
            .. "Blood must be on."

        -- Joins the options window's page loops; run from the page's OnLoad, after its rows.
        function BenillaPhysicsOptions_Register()
            table.insert(BENILLA_OPTIONS_CATEGORY_KEYS, "Physics")
            BENILLA_OPTIONS_PAGE_ROWS.Physics = {
                "RowBlood", "RowGoreAmount", "RowBloodStains", "RowDismemberment", "RowDismemberAmount",
                "RowDeathPush", "RowDeathLift", "RowSpellPush", "RowMeleeDelay", "RowStiffness", "RowDeathEffects",
                "RowBodyPhysics", "RowBodySize", "RowBodyRearSize",
                "RowWeaponMotion", "RowFootPlanting", "RowOmniMovement",
            }
        end
    ]]></Script>

    <!-- The category row, under the System group's last row. -->
    <Button name="BenillaOptionsFrameCategoryListRowPhysics" parent="BenillaOptionsFrameCategoryList" inherits="BenillaOptionsCategoryRowTemplate">
        <Anchors><Anchor point="TOPLEFT" relativeTo="BenillaOptionsFrameCategoryListRowAudio" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
        <Scripts><OnLoad>BenillaOptionsCategoryRow_OnLoad(this, "Physics", "Physics")</OnLoad></Scripts>
    </Button>

    <!-- The search results' group head. -->
    <Button name="BenillaOptionsFrameContainerBodySearchHeadPhysics" parent="BenillaOptionsFrameContainerBody" inherits="BenillaOptionsSearchHeadTemplate">
        <Scripts><OnLoad>
            this.categoryKey = "Physics"
            getglobal(this:GetName() .. "Label"):SetText("Physics")
        </OnLoad></Scripts>
    </Button>

    <!-- The page, laid out as the other pages are: the first row at (10,-12), each next 9 below. -->
    <Frame name="BenillaOptionsFrameContainerBodyPhysics" parent="BenillaOptionsFrameContainerBody" hidden="true">
        <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT"/>
        </Anchors>
        <Frames>
            <Frame name="$parentRowBlood" inherits="BenillaOptionsDropdownRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="10" y="-12"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT"><Offset><AbsDimension x="-20" y="-12"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "violenceLevel", "Blood", "BENILLA_TOOLTIP_BLOOD")
                    BenillaOptionsDropdownRow_Setup(this, {
                        { text = "Red", value = "2" },
                        { text = "Green", value = "1" },
                        { text = "Off", value = "0" },
                    })
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowGoreAmount" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowBlood" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowBlood" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "goreAmount", "Gore Amount",
                        "BENILLA_TOOLTIP_GORE_AMOUNT")
                    BenillaOptionsSliderRow_Setup(this, 0, 10, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowBloodStains" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowGoreAmount" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowGoreAmount" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "bloodStains", "Blood Stains",
                        "BENILLA_TOOLTIP_BLOOD_STAINS")
                    BenillaOptionsSliderRow_Setup(this, 0, 3, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowDismemberment" inherits="BenillaOptionsCheckboxRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowBloodStains" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowBloodStains" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "dismemberment", "Dismemberment",
                        "BENILLA_TOOLTIP_DISMEMBERMENT")
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowDismemberAmount" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowDismemberment" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowDismemberment" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "dismemberAmount", "Dismemberment Amount",
                        "BENILLA_TOOLTIP_DISMEMBER_AMOUNT")
                    BenillaOptionsSliderRow_Setup(this, 0.25, 10, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowDeathPush" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowDismemberAmount" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowDismemberAmount" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "ragdollPush", "Death Push",
                        "BENILLA_TOOLTIP_DEATH_PUSH")
                    BenillaOptionsSliderRow_Setup(this, 0, 10, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowDeathLift" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowDeathPush" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowDeathPush" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "ragdollLift", "Death Lift",
                        "BENILLA_TOOLTIP_DEATH_LIFT")
                    BenillaOptionsSliderRow_Setup(this, 0, 10, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowSpellPush" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowDeathLift" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowDeathLift" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "ragdollSpellPush", "Spell Push",
                        "BENILLA_TOOLTIP_SPELL_PUSH")
                    BenillaOptionsSliderRow_Setup(this, 0.5, 10, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowMeleeDelay" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowSpellPush" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowSpellPush" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "ragdollMeleeDelay", "Melee Death Delay",
                        "BENILLA_TOOLTIP_MELEE_DELAY")
                    BenillaOptionsSliderRow_Setup(this, 0, 1, 0.05)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowStiffness" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowMeleeDelay" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowMeleeDelay" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "ragdollStiffness", "Ragdoll Stiffness",
                        "BENILLA_TOOLTIP_RAGDOLL_STIFFNESS")
                    BenillaOptionsSliderRow_Setup(this, 0, 1, 0.1)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowDeathEffects" inherits="BenillaOptionsCheckboxRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowStiffness" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowStiffness" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "deathEffects", "Death Effects",
                        "BENILLA_TOOLTIP_DEATH_EFFECTS")
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowBodyPhysics" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowDeathEffects" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowDeathEffects" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "bodyPhysics", "Body Physics",
                        "BENILLA_TOOLTIP_BODY_PHYSICS")
                    BenillaOptionsSliderRow_Setup(this, 0, 3, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowBodySize" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowBodyPhysics" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowBodyPhysics" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "bodySize", "Chest Size",
                        "BENILLA_TOOLTIP_BODY_SIZE")
                    BenillaOptionsSliderRow_Setup(this, 0.5, 2.5, 0.1)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowBodyRearSize" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowBodySize" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowBodySize" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "bodyRearSize", "Rear Size",
                        "BENILLA_TOOLTIP_BODY_REAR_SIZE")
                    BenillaOptionsSliderRow_Setup(this, 0.5, 2.5, 0.1)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowWeaponMotion" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowBodyRearSize" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowBodyRearSize" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "weaponMotion", "Weapon Motion",
                        "BENILLA_TOOLTIP_WEAPON_MOTION")
                    BenillaOptionsSliderRow_Setup(this, 0, 3, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowFootPlanting" inherits="BenillaOptionsSliderRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowWeaponMotion" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowWeaponMotion" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "footPlanting", "Foot Planting",
                        "BENILLA_TOOLTIP_FOOT_PLANTING")
                    BenillaOptionsSliderRow_Setup(this, 0, 1, 0.25)
                </OnLoad></Scripts>
            </Frame>
            <Frame name="$parentRowOmniMovement" inherits="BenillaOptionsCheckboxRowTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRowFootPlanting" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                    <Anchor point="TOPRIGHT" relativeTo="$parentRowFootPlanting" relativePoint="BOTTOMRIGHT"><Offset><AbsDimension x="0" y="-9"/></Offset></Anchor>
                </Anchors>
                <Scripts><OnLoad>
                    BenillaOptionsRow_OnLoad(this, "omniMovement", "Turn Around on Back",
                        "BENILLA_TOOLTIP_OMNI_MOVEMENT")
                </OnLoad></Scripts>
            </Frame>
        </Frames>
        <Scripts>
            <!-- The loader fires OnLoad bottom-up, so the rows already exist. -->
            <OnLoad>BenillaPhysicsOptions_Register()</OnLoad>
        </Scripts>
    </Frame>
</Ui>
